PRELUDE

package rv;

import assertion.Assertion;
import fits.UserInfo;
import fits.UserSession;
import java.util.HashMap;

AUTOMATA

// Property 1: Post-Greylist Probation Period (K = 3 deposits required before withdrawal)
property foreach target (UserInfo u) starting Normal keep (Integer count defaultTo 0) {

    Normal >>> after UserInfo.makeGreylisted(..) target (UserInfo u)
           >>> Greylisted

    Greylisted >>> after UserInfo.makeWhitelisted(..) target (UserInfo u)
               | -> { count = 0; }
               >>> Probation

    Greylisted >>> after UserInfo.makeBlacklisted(..) target (UserInfo u)
               >>> Normal

    Probation >>> after UserInfo.depositTo(..) target (UserInfo u)
              | count < 2 -> { count = count + 1; }
              >>> Probation

    Probation >>> after UserInfo.depositTo(..) target (UserInfo u)
              | count >= 2 -> { count = count + 1; }
              >>> Normal

    Probation >>> after UserInfo.makeGreylisted(..) target (UserInfo u)
              >>> Greylisted

    Probation >>> after UserInfo.makeBlacklisted(..) target (UserInfo u)
              >>> Normal

    Probation >>> before UserInfo.withdrawFrom(..) target (UserInfo u)
              >>> Bad[Probation violated: withdrawal before completing 3 deposits]
}